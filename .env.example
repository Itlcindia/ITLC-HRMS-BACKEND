# ==============================================================================
# HRMS & CRM ENTERPRISE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_strong_mysql_password
DB_NAME=hrms_enterprise_db

# Security & JWT Token Authentication
JWT_SECRET=your_super_secret_jwt_encryption_key_2026

# Payment Gateway Configurations (Super Owner & System Level)
# Razorpay Integration
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_SECRET=your_razorpay_secret_key

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_or_live_stripe_secret_key

# UPI Direct Payment ID (For QR Code Payments)
REAL_UPI_ID=your_merchant_vpa@upi

# Automated Email Notifications (SMTP / Nodemailer)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_email_account_password
SMTP_FROM="Enterprise HRMS" <no-reply@yourdomain.com>
